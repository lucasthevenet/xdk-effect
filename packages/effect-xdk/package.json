{
  "name": "effect-xdk",
  "version": "0.1.0",
  "description": "Spec-generated, Effect-native X API SDK with OAuth, streaming, and webhook primitives.",
  "keywords": [
    "api",
    "effect",
    "oauth",
    "sdk",
    "twitter",
    "webhook",
    "x"
  ],
  "homepage": "https://github.com/lucasthevenet/alchemy-x#readme",
  "bugs": "https://github.com/lucasthevenet/alchemy-x/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasthevenet/alchemy-x.git",
    "directory": "packages/effect-xdk"
  },
  "files": [
    "lib",
    "!lib/.tsbuildinfo",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./Credentials": {
      "types": "./lib/credentials.d.ts",
      "bun": "./src/credentials.ts",
      "worker": "./src/credentials.ts",
      "default": "./lib/credentials.js"
    },
    "./Errors": {
      "types": "./lib/errors.d.ts",
      "bun": "./src/errors.ts",
      "worker": "./src/errors.ts",
      "default": "./lib/errors.js"
    },
    "./Traits": {
      "types": "./lib/traits.d.ts",
      "bun": "./src/traits.ts",
      "worker": "./src/traits.ts",
      "default": "./lib/traits.js"
    },
    "./Protocol": {
      "types": "./lib/protocol.d.ts",
      "bun": "./src/protocol.ts",
      "worker": "./src/protocol.ts",
      "default": "./lib/protocol.js"
    },
    "./Retry": {
      "types": "./lib/retry.d.ts",
      "bun": "./src/retry.ts",
      "worker": "./src/retry.ts",
      "default": "./lib/retry.js"
    },
    "./OAuth": {
      "types": "./lib/oauth.d.ts",
      "bun": "./src/oauth.ts",
      "worker": "./src/oauth.ts",
      "default": "./lib/oauth.js"
    },
    "./Webhooks": {
      "types": "./lib/webhooks.d.ts",
      "bun": "./src/webhooks.ts",
      "worker": "./src/webhooks.ts",
      "default": "./lib/webhooks.js"
    },
    "./Client": null,
    "./client": null,
    "./auth": null,
    "./oauth": {
      "types": "./lib/oauth.d.ts",
      "bun": "./src/oauth.ts",
      "worker": "./src/oauth.ts",
      "default": "./lib/oauth.js"
    },
    "./runtime": null,
    "./types": {
      "types": "./lib/types.d.ts",
      "bun": "./src/types.ts",
      "worker": "./src/types.ts",
      "default": "./lib/types.js"
    },
    "./errors": {
      "types": "./lib/errors.d.ts",
      "bun": "./src/errors.ts",
      "worker": "./src/errors.ts",
      "default": "./lib/errors.js"
    },
    "./services/*": {
      "types": "./lib/services/*.d.ts",
      "bun": "./src/services/*.ts",
      "worker": "./src/services/*.ts",
      "default": "./lib/services/*.js"
    },
    "./*": {
      "types": "./lib/services/*.d.ts",
      "bun": "./src/services/*.ts",
      "worker": "./src/services/*.ts",
      "default": "./lib/services/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "specs:fetch": "bun scripts/specs.ts",
    "specs:update": "bun scripts/specs.ts --update",
    "convert": "bun scripts/convert.ts",
    "generate": "bun scripts/convert.ts && bun scripts/generate.ts",
    "generate:check": "bun scripts/check-generated.ts",
    "build": "tsc -b",
    "prepack": "bun run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@distilled.cloud/core": "1.0.0-rc.8"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.112"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.112 <5"
  }
}
