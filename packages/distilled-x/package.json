{
  "name": "distilled-x",
  "version": "0.1.0",
  "description": "Spec-generated, Effect-native X API SDK with OAuth, streaming, and webhook primitives.",
  "keywords": [
    "api",
    "effect",
    "oauth",
    "sdk",
    "twitter",
    "webhook",
    "x"
  ],
  "homepage": "https://github.com/lucasthevenet/alchemy-x#readme",
  "bugs": "https://github.com/lucasthevenet/alchemy-x/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasthevenet/alchemy-x.git",
    "directory": "packages/distilled-x"
  },
  "files": [
    "lib",
    "!lib/.tsbuildinfo",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "bun": "./src/*.ts",
      "worker": "./src/*.ts",
      "default": "./lib/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "specs:fetch": "bun scripts/specs.ts",
    "specs:update": "bun scripts/specs.ts --update",
    "generate": "bun scripts/generate.ts",
    "generate:check": "bun scripts/generate.ts --check",
    "build": "tsc -b",
    "prepack": "bun run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@distilled.cloud/core": "1.0.0-rc.8"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.112 <5"
  }
}
