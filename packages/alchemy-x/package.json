{
  "name": "alchemy-x",
  "version": "0.1.0",
  "description": "Alchemy V2 provider for X webhooks and activity subscriptions.",
  "keywords": [
    "alchemy",
    "effect",
    "twitter",
    "webhook",
    "x"
  ],
  "homepage": "https://github.com/lucasthevenet/alchemy-x#readme",
  "bugs": "https://github.com/lucasthevenet/alchemy-x/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasthevenet/alchemy-x.git",
    "directory": "packages/alchemy-x"
  },
  "files": [
    "lib",
    "!lib/.tsbuildinfo",
    "!lib/WebhookRoute.*",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./internal": null,
    "./internal/*": null,
    "./WebhookRoute": null,
    "./*": {
      "types": "./lib/*.d.ts",
      "bun": "./src/*.ts",
      "worker": "./src/*.ts",
      "default": "./lib/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf lib && tsc -b --force",
    "prepack": "bun run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "distilled-x": "0.1.0"
  },
  "devDependencies": {
    "alchemy": "2.0.0-beta.75"
  },
  "peerDependencies": {
    "alchemy": "2.0.0-beta.75",
    "effect": ">=4.0.0-rc.112 <5"
  }
}
